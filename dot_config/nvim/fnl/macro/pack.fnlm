;; fennel-ls: macro-file
(local {: str? : nil? : tbl?} (require :utils))
(local {: insert} table)

(global global-packs [])

(global default-slug-base "https://github.com/")

(fn slug? [x]
  (nil? (string.find x "://")))

(λ slug->url [x]
  (if slug?
      (.. default-slug-base x)
      x))

(λ pack [identifier ?options]
  "Returns a mixed table with the identifier as the first sequential element
  and options as hash-table items.
  See :h vim.pack.Spec for information about the
  options."
  (assert-compile (str? identifier) "expected string for identifier" identifier)
  (assert-compile (or (nil? ?options) (tbl? ?options))
                  "expected table for options" ?options)
  (let [identifier (slug->url identifier)
        options (or ?options {})
        options (collect [k v (pairs options)]
                  (if (= k :setup)
                      (values :data {k v})
                      (values k v)))]
    (doto options
      (tset :src identifier))))

(λ pack! [identifier ?options]
  "Declares a plugin with its options.
  This is a mixed table saved on the global compile-time variable global-packs.
  See :h vim.pack.Spec for information about the
  options."
  (assert-compile (str? identifier) "expected string for identifier" identifier)
  (assert-compile (or (nil? ?options) (tbl? ?options))
                  "expected table for options" ?options)
  (insert global-packs (pack identifier ?options)))

(λ unpack! []
  "Initializes the plugin manager with the previously declared plugins and
  their options."
  (let [packs [(unpack (icollect [_ v (ipairs global-packs)]
                         v))]]
    `(vim.pack.add ,packs {:load (fn [plug#]
                                  (let [data# (or plug#.spec.data {})
                                        setup# data#.setup]
                                    (vim.cmd.packadd plug#.spec.name)
                                    (when (and (not= setup# nil)
                                               (= (type setup#) :function))
                                      (setup#))))})))

{: pack : pack! : unpack!}
